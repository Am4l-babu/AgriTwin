# =============================================================================
# Fog Layer — Environment Variables (Raspberry Pi Zero 2 W)
# =============================================================================
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env
#   nano .env
#
# The fog layer runs on the Raspberry Pi. The cloud backend runs on the laptop.
# =============================================================================

# ── Device Identification ─────────────────────────────────────────────────────
FARM_ID=farm_001
FOG_DEVICE_ID=fog_rpi_001
ENVIRONMENT=production

# ── Fog API ───────────────────────────────────────────────────────────────────
FOG_API_HOST=0.0.0.0
FOG_API_PORT=8001
FOG_API_RELOAD=false

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Mosquitto runs locally on the Raspberry Pi, so use localhost here.
# ESP32 devices connect to this Pi using agritwin-fog.local (mDNS/Avahi).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_QOS=1

# ── Cloud Backend ─────────────────────────────────────────────────────────────
# IMPORTANT: Set CLOUD_API_URL to the laptop's IP or mDNS hostname.
# The Raspberry Pi sends processed sensor data to this endpoint.
# Example: CLOUD_API_URL=http://192.168.1.42:8000
# Do NOT use localhost — that would point back to the Pi itself.
CLOUD_API_URL=http://<laptop-ip>:8000
CLOUD_BACKEND_URL=http://<laptop-ip>:8000
CLOUD_SYNC_INTERVAL_SEC=30
CLOUD_CONNECTION_TIMEOUT=10

# ── Redis (hot buffer — runs on Raspberry Pi) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── SQLite (cold buffer) ──────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/fog_buffer.db

# ── Buffer Limits ─────────────────────────────────────────────────────────────
BUFFER_MAX_SIZE_MB=100
BUFFER_MAX_RECORDS=100000
BUFFER_RETENTION_DAYS=7
BUFFER_SYNC_BATCH_SIZE=100

# ── Emergency Control ─────────────────────────────────────────────────────────
EMERGENCY_CONTROL_ENABLED=true
IRRIGATION_THRESHOLD=30.0
TEMPERATURE_ALERT=35.0
EMERGENCY_RULES_FILE=./config/emergency_rules.yaml

# ── Digital Twin ─────────────────────────────────────────────────────────────
DIGITAL_TWIN_ENABLED=true
SIMULATION_INTERVAL_SEC=300

# ── Buffering ─────────────────────────────────────────────────────────────────
HOT_BUFFER_HOURS=1
COLD_BUFFER_DAYS=7

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/fog.log
LOG_FILE_PATH=./logs/fog_gateway.log
