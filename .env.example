# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

ENVIRONMENT=development  # development, staging, production

# ========================================
# MQTT BROKER
# ========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_USERNAME=smart_farming
MQTT_PASSWORD=change_me_in_production
MQTT_CLIENT_ID=cloud_backend
MQTT_KEEPALIVE=60

# ========================================
# INFLUXDB (Time-series Database)
# ========================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-token-change-me
INFLUXDB_ORG=smart_farming_org
INFLUXDB_BUCKET=sensor_data
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin_password_change_me

# ========================================
# POSTGRESQL (Relational Database)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_farming
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================================
# REDIS (Cache & Session Store)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ========================================
# BACKEND API
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Only for development
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
SECRET_KEY=your-secret-key-min-32-chars-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ========================================
# FRONTEND
# ========================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MQTT_WS_URL=ws://localhost:9001

# ========================================
# FOG LAYER
# ========================================
FOG_API_PORT=8001
FOG_MQTT_BROKER=localhost
FOG_BUFFER_SIZE_MB=100
FOG_OFFLINE_MODE_ENABLED=true
FOG_SYNC_INTERVAL_SECONDS=30

# ========================================
# DIGITAL TWIN
# ========================================
DIGITAL_TWIN_SIMULATION_INTERVAL_SECONDS=300  # 5 minutes
DIGITAL_TWIN_SYNC_ENABLED=true
DIGITAL_TWIN_PREDICTION_ENABLED=true
DIGITAL_TWIN_OPTIMIZATION_ENABLED=true

# ========================================
# AI ENGINE
# ========================================
AI_MODEL_PATH=./models
AI_PREDICTION_INTERVAL_HOURS=1
AI_RETRAINING_INTERVAL_DAYS=7
TENSORFLOW_DEVICE=CPU  # CPU or GPU
AI_BATCH_SIZE=32
AI_MAX_WORKERS=2

# ========================================
# MONITORING & LOGGING
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=./logs/app.log
LOG_ROTATION_SIZE_MB=10
LOG_RETENTION_DAYS=30

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ========================================
# ALERTING
# ========================================
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=noreply@smart-farming.io
ALERT_EMAIL_TO=admin@smart-farming.io

ALERT_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# EDGE DEVICE (for configuration API)
# ========================================
EDGE_OTA_ENABLED=true
EDGE_OTA_SERVER_URL=http://192.168.1.100:8000/firmware
EDGE_SLEEP_DURATION_SECONDS=300  # Deep sleep duration
EDGE_CALIBRATION_MODE=false

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ========================================
# CLOUD PROVIDER (Optional)
# ========================================
CLOUD_PROVIDER=none  # aws, gcp, azure, none
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=smart-farming-data

# ========================================
# FEATURES FLAGS
# ========================================
FEATURE_MULTI_TENANCY=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
FEATURE_OPTIMIZATION_ENGINE=true
FEATURE_SCENARIO_SIMULATION=true
FEATURE_MOBILE_API=true
